{
  "name": "fieldnotes-nature-photography",
  "version": "1.0.0",
  "private": true,
  "description": "Fieldnotes \u2014 a free, location-neutral nature photography roadmap in one static HTML file",
  "scripts": {
    "test": "node tools/smoke-test.mjs && node tools/responsive-check.mjs",
    "noscript": "python3 tools/gen-noscript.py",
    "noscript:check": "python3 tools/gen-noscript.py --check",
    "serve": "python3 -m http.server 8000",
    "test:responsive": "node tools/responsive-check.mjs",
    "test:browser": "node tools/browser-check.mjs"
  },
  "devDependencies": {
    "jsdom": "^24.1.3"
  }
}
